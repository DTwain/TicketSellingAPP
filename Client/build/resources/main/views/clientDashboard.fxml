<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.*?>

<?import javafx.scene.control.cell.PropertyValueFactory?>
<VBox xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="org.example.controller.ClientDashboardController" spacing="10"
      style="-fx-padding: 20;">

    <Label text="Basketball Ticket Shop - Client Dashboard" style="-fx-font-size: 20; -fx-font-weight: bold;"/>

    <TableView fx:id="matchesTable" style="-fx-pref-height: 300;">
        <columns>
            <TableColumn text="Match" prefWidth="200">
                <cellValueFactory>
                    <PropertyValueFactory property="matchDescription" />
                </cellValueFactory>
            </TableColumn>
            <TableColumn text="Date" prefWidth="150">
                <cellValueFactory>
                    <PropertyValueFactory property="formattedDate" />
                </cellValueFactory>
            </TableColumn>
            <TableColumn text="Available Seats" prefWidth="100">
                <cellValueFactory>
                    <PropertyValueFactory property="availableTickets" />
                </cellValueFactory>
            </TableColumn>
            <TableColumn text="Price Range" prefWidth="120">
                <cellValueFactory>
                    <PropertyValueFactory property="priceRange" />
                </cellValueFactory>
            </TableColumn>
        </columns>
    </TableView>

    <HBox spacing="10" alignment="CENTER_RIGHT">
        <Button text="View My Tickets" onAction="#handleViewTickets"
                style="-fx-pref-width: 120; -fx-background-color: #4285f4; -fx-text-fill: white;"/>
        <Button text="Logout" onAction="#handleLogout"
                style="-fx-pref-width: 80; -fx-background-color: #ff4444; -fx-text-fill: white;"/>
    </HBox>
</VBox>