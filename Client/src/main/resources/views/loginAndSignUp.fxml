<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.*?>
<?import javafx.geometry.*?>

<BorderPane xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="org.example.controller.LoginController">
    <center>
        <VBox alignment="CENTER" spacing="20" style="-fx-background-color: #f5f5f5;">
            <!-- Main container that will toggle between login and signup -->
            <StackPane fx:id="formContainer" prefWidth="300" prefHeight="400">
                <!-- Login Form (shown by default) -->
                <VBox fx:id="loginForm" alignment="CENTER" spacing="15" style="-fx-padding: 30;">
                    <Text text="Basketball Ticket Shop" style="-fx-font-size: 24; -fx-font-weight: bold;"/>
                    <Text text="Please login to continue" fill="#666"/>

                    <VBox spacing="5">
                        <Label text="Username"/>
                        <TextField fx:id="loginUsername" promptText="Enter your username"/>
                    </VBox>

                    <VBox spacing="5">
                        <Label text="Password"/>
                        <PasswordField fx:id="loginPassword" promptText="Enter your password"/>
                    </VBox>

                    <Button fx:id="loginButton" onAction="#handleLogin" text="Login"
                            style="-fx-background-color: #4285f4; -fx-text-fill: white; -fx-font-weight: bold; -fx-pref-width: 200;"/>

                    <HBox alignment="CENTER" spacing="5">
                        <Text text="Don't have an account?"/>
                        <Button fx:id="showSignupButton" onAction="#toggleForms" text="Sign Up"
                                style="-fx-background-color: transparent; -fx-text-fill: #4285f4; -fx-underline: true; -fx-padding: 0;"/>
                    </HBox>
                </VBox>

                <!-- Signup Form (hidden by default) -->
                <VBox fx:id="signupForm" alignment="CENTER" spacing="15" style="-fx-padding: 30;" visible="false">
                    <Text text="Create Account" style="-fx-font-size: 24; -fx-font-weight: bold;"/>
                    <Text text="Join Basketball Ticket Shop" fill="#666"/>

                    <VBox spacing="5">
                        <Label text="Username"/>
                        <TextField fx:id="signupUsername" promptText="Choose a username"/>
                    </VBox>

                    <VBox spacing="5">
                        <Label text="Password"/>
                        <PasswordField fx:id="signupPassword" promptText="Create a password"/>
                    </VBox>

                    <VBox spacing="5">
                        <Label text="Confirm Password"/>
                        <PasswordField fx:id="signupConfirmPassword" promptText="Re-enter your password"/>
                    </VBox>

                    <Button fx:id="signupButton" onAction="#handleSignup" text="Sign Up"
                            style="-fx-background-color: #4285f4; -fx-text-fill: white; -fx-font-weight: bold; -fx-pref-width: 200;"/>

                    <HBox alignment="CENTER" spacing="5">
                        <Text text="Already have an account?"/>
                        <Button fx:id="showLoginButton" onAction="#toggleForms" text="Login"
                                style="-fx-background-color: transparent; -fx-text-fill: #4285f4; -fx-underline: true; -fx-padding: 0;"/>
                    </HBox>
                </VBox>
            </StackPane>
        </VBox>
    </center>
</BorderPane>