<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.*?>

<?import javafx.scene.control.cell.PropertyValueFactory?>
<VBox xmlns="http://javafx.com/javafx/8.0.171" xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="org.example.controller.CustomerSearchController" spacing="10"
      style="-fx-padding: 20;">

    <Label text="Search Customer Tickets" style="-fx-font-size: 20; -fx-font-weight: bold;"/>

    <GridPane hgap="10" vgap="10">
        <Label text="Customer Name:" GridPane.rowIndex="0" GridPane.columnIndex="0"/>
        <TextField fx:id="nameField" GridPane.rowIndex="0" GridPane.columnIndex="1"/>
    </GridPane>

    <Button text="Search" onAction="#handleSearch"
            style="-fx-pref-width: 100; -fx-background-color: #2196F3; -fx-text-fill: white;"/>

    <TableView fx:id="resultsTable" style="-fx-pref-height: 300;">
        <columns>
            <TableColumn text="Customer Name" prefWidth="150">
                <cellValueFactory>
                    <PropertyValueFactory property="customerName"/>
                </cellValueFactory>
            </TableColumn>
            <TableColumn text="Customer Address" prefWidth="150">
                <cellValueFactory>
                    <PropertyValueFactory property="customerAddress"/>
                </cellValueFactory>
            </TableColumn>
            <TableColumn text="Match" prefWidth="200">
                <cellValueFactory>
                    <PropertyValueFactory property="matchDescription"/>
                </cellValueFactory>
            </TableColumn>
            <TableColumn text="Seat Purchased" prefWidth="100">
                <cellValueFactory>
                    <PropertyValueFactory property="seatNumber"/>
                </cellValueFactory>
            </TableColumn>
        </columns>
    </TableView>

    <Button text="Close" onAction="#handleClose"
            style="-fx-pref-width: 80;"/>
</VBox>